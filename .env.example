# API 金鑰（逗號分隔多把；沒設＝開放，僅限本機開發）
API_KEYS=

# 服務埠
PORT=8071

# 部署時務必 true
HEADLESS=true

# 音檔保留天數
AUDIO_RETENTION_DAYS=14

# 以下都有預設值，要改才取消註解
# HOST=0.0.0.0
# QUEUE_MAX_SIZE=10
# DEFAULT_TIMEOUT=600
# PROFILE_DIR=/home/YOU/.suno-web/profiles
# GENERATED_DIR=/home/YOU/.suno-web/generated
# SUNO_URL=https://suno.com/create
# STEALTH_TIMEZONE=Asia/Taipei
